{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/plitsoft/policypack/schemas/report-1.json",
  "title": "policypack scan 보고서 (schema_version 1)",
  "description": "policypack scan --output-format json 의 출력. 같은 schema_version 안에서 키가 늘 수 있다(받는 쪽은 모르는 키를 무시한다). 있던 키가 없어지거나 뜻이 바뀌면 schema_version 을 올린다. 파일 경로는 검사 루트(git 저장소면 그 뿌리)에서의 상대 경로다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tool",
    "run",
    "findings"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "tool": {
      "type": "object",
      "properties": {
        "name": {
          "const": "policypack"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "run": {
      "$ref": "#/$defs/run"
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    }
  },
  "$defs": {
    "outcome": {
      "enum": [
        "compliant",
        "needs-review",
        "needs-review-uncertain",
        "not-applicable"
      ]
    },
    "untested": {
      "enum": [
        "parse-error",
        "engine-incomplete",
        "no-judge",
        "judge-unavailable",
        "judge-unparseable",
        "citation-rejected",
        "weak-unconfirmed",
        "timeout"
      ]
    },
    "usage": {
      "type": "object",
      "description": "Messages API 의 usage 를 더한 값(input_tokens, output_tokens, cache_creation_input_tokens, cache_read_input_tokens 등)",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "run": {
      "type": "object",
      "properties": {
        "judge": {
          "anyOf": [
            {
              "type": "string",
              "description": "--judge 판정자. 실제 모델 id 를 싣는다(anthropic:claude-haiku-5-5). 판정자를 끄면 null"
            },
            {
              "type": "null"
            }
          ]
        },
        "pack_digest": {
          "type": "string"
        },
        "fingerprint_version": {
          "type": "string"
        },
        "questions_asked": {
          "type": "integer",
          "minimum": 0
        },
        "ai_answered": {
          "type": "integer",
          "minimum": 0
        },
        "questions_sent": {
          "type": "integer",
          "minimum": 0
        },
        "questions_skipped": {
          "type": "integer",
          "minimum": 0
        },
        "ai_pending": {
          "type": "integer",
          "minimum": 0
        },
        "ai_cleared": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "policy": {
                "type": "string"
              },
              "rule": {
                "type": "string"
              },
              "file": {
                "type": "string"
              },
              "line": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "alternatives": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "cite": {
                      "type": "string"
                    },
                    "gate": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "cite",
                    "gate",
                    "id"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "alternatives",
              "file",
              "line",
              "policy",
              "rule"
            ],
            "additionalProperties": false,
            "description": "판정자의 '예'와 관문을 통과한 인용으로 풀린 단위"
          }
        },
        "ai_dismissed": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "policy": {
                "type": "string"
              },
              "rule": {
                "type": "string"
              },
              "file": {
                "type": "string"
              },
              "line": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "question": {
                "type": "string"
              },
              "answer": {
                "type": "string"
              }
            },
            "required": [
              "answer",
              "file",
              "line",
              "policy",
              "question",
              "rule"
            ],
            "additionalProperties": false,
            "description": "적용 질문의 '아니오'로 빠진 단위"
          }
        },
        "static_cleared": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "policy": {
                "type": "string"
              },
              "rule": {
                "type": "string"
              },
              "file": {
                "type": "string"
              },
              "line": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "alternatives": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "lines": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": 1
                      }
                    }
                  },
                  "required": [
                    "id",
                    "lines"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "alternatives",
              "file",
              "line",
              "policy",
              "rule"
            ],
            "additionalProperties": false,
            "description": "강한 정적 대안으로 풀린 단위"
          }
        },
        "engine": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "version": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "name",
                "version"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "static_seconds": {
          "type": "number",
          "minimum": 0
        },
        "ai_seconds": {
          "type": "number",
          "minimum": 0
        },
        "units": {
          "type": "integer",
          "minimum": 0,
          "description": "판정 단위 수. 에이전트를 끄면 findings + ai_cleared + static_cleared 와 같다. --agent 를 켜면 에이전트가 푼 단위·새로 찾은 경고가 그 관계 밖이다(run.agent 를 본다)"
        },
        "unparsed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skipped": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "incomplete": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "engine_errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "coverage_complete": {
          "type": "boolean"
        },
        "finding_counts": {
          "type": "object",
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "service": {
              "type": "integer",
              "minimum": 0
            },
            "non_service": {
              "type": "integer",
              "minimum": 0
            },
            "by_role": {
              "type": "object",
              "propertyNames": {
                "$ref": "#/$defs/role"
              },
              "additionalProperties": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "required": [
            "total",
            "service",
            "non_service",
            "by_role"
          ],
          "additionalProperties": false,
          "description": "findings 를 파일 역할로 나눈 수. service 는 server·screen·other, non_service 는 test·config. 판정과 종료 코드는 역할을 보지 않는다"
        },
        "files": {
          "type": "integer",
          "minimum": 0
        },
        "judge_usage": {
          "$ref": "#/$defs/usage"
        },
        "judge_masked": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          },
          "description": "판정자(--judge)에게 보내기 전에 가린 비밀값 수(종류별). 가린 것이 있을 때만 있다"
        },
        "agent": {
          "$ref": "#/$defs/agent"
        }
      },
      "required": [
        "ai_answered",
        "ai_cleared",
        "ai_dismissed",
        "ai_pending",
        "ai_seconds",
        "coverage_complete",
        "engine",
        "engine_errors",
        "fingerprint_version",
        "incomplete",
        "judge",
        "pack_digest",
        "questions_asked",
        "questions_sent",
        "questions_skipped",
        "skipped",
        "static_cleared",
        "static_seconds",
        "units",
        "unparsed"
      ],
      "additionalProperties": false
    },
    "role": {
      "enum": [
        "test",
        "config",
        "server",
        "screen",
        "other"
      ],
      "description": "파일 역할(index/roles.py). test 는 시험·픽스처·목업·스토리(경로로만 고른다), config 는 설정 파일. 경로와 내용의 모양으로 고른 힌트다"
    },
    "finding": {
      "type": "object",
      "properties": {
        "policy": {
          "type": "string"
        },
        "rule": {
          "type": "string",
          "description": "팩의 규칙 id. 에이전트가 새로 찾은 경고는 agent-independent(독립 검토) 또는 agent-discovered(결합의 찾기 단계)다"
        },
        "outcome": {
          "$ref": "#/$defs/outcome"
        },
        "file": {
          "type": "string"
        },
        "line": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "role": {
          "$ref": "#/$defs/role"
        },
        "case": {
          "type": [
            "string",
            "null"
          ]
        },
        "category": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "law": {
          "type": "string"
        },
        "ask_developer": {
          "type": "string"
        },
        "untested_reasons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/untested"
          }
        },
        "ai_pending": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fingerprint": {
          "type": "string"
        },
        "scope": {
          "enum": [
            "file",
            "anchor"
          ]
        },
        "region": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "start_line": {
                  "type": "integer",
                  "minimum": 1
                },
                "end_line": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "end_line",
                "start_line"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "top_level": {
          "type": "boolean"
        },
        "anchor_lines": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "unsatisfied_alternatives": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "ask_developer": {
                "type": "string"
              },
              "remediation": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "value": {
                "enum": [
                  "true",
                  "false",
                  "unknown"
                ]
              }
            },
            "required": [
              "ask_developer",
              "id",
              "message",
              "remediation",
              "value"
            ],
            "additionalProperties": false
          }
        },
        "decision_path": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "agent": {
          "$ref": "#/$defs/findingAgent"
        }
      },
      "required": [
        "ai_pending",
        "anchor_lines",
        "ask_developer",
        "case",
        "category",
        "decision_path",
        "file",
        "fingerprint",
        "law",
        "line",
        "outcome",
        "policy",
        "region",
        "rule",
        "scope",
        "title",
        "top_level",
        "unsatisfied_alternatives",
        "untested_reasons"
      ],
      "additionalProperties": false
    },
    "citation": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string"
        },
        "line": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "type": "string"
        },
        "ok": {
          "type": "boolean"
        },
        "why": {
          "enum": [
            "grounded",
            "outside-repo",
            "no-such-file",
            "not-entry-file",
            "trailing-comment",
            "comment-only",
            "not-found",
            "too-short",
            "bare-word",
            "empty"
          ]
        },
        "line_model": {
          "description": "관문이 줄을 바로잡았을 때 모델이 적었던 줄",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "file",
        "line",
        "ok",
        "text",
        "why"
      ],
      "additionalProperties": false,
      "description": "에이전트의 인용과 관문 결과. ok 인 인용의 line 은 관문이 코드에서 다시 구한 줄이다"
    },
    "verdict": {
      "enum": [
        "compliant",
        "not-compliant",
        "not-applicable",
        "unknown"
      ]
    },
    "action": {
      "enum": [
        "cleared",
        "kept-ungrounded",
        "confirmed",
        "kept",
        "kept-no-answer",
        "compliant",
        "not-applicable",
        "warned",
        "warned-uncertain",
        "dropped-no-file",
        "dropped-out-of-scope",
        "dropped-known",
        "dropped-duplicate",
        "dropped-ungrounded"
      ]
    },
    "findingAgent": {
      "type": "object",
      "properties": {
        "verdict": {
          "anyOf": [
            {
              "$ref": "#/$defs/verdict"
            },
            {
              "type": "null"
            }
          ]
        },
        "action": {
          "$ref": "#/$defs/action"
        },
        "reason": {
          "type": "string"
        },
        "citations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          }
        },
        "question": {
          "type": [
            "integer",
            "null"
          ]
        },
        "line_model": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "action"
      ],
      "additionalProperties": false,
      "description": "이 경고에 대한 에이전트의 답과 반영 결과(--agent 를 켰을 때만)"
    },
    "question": {
      "type": "object",
      "properties": {
        "n": {
          "type": "integer",
          "minimum": 0
        },
        "policy": {
          "type": "string"
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "carried": {
          "type": "integer",
          "minimum": 0
        },
        "known": {
          "type": "integer",
          "minimum": 0
        },
        "failure": {
          "type": [
            "string",
            "null"
          ]
        },
        "calls": {
          "type": "integer",
          "minimum": 0
        },
        "stop_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "partial": {
          "type": "boolean"
        },
        "tool_calls": {
          "type": "integer",
          "minimum": 0
        },
        "budget": {
          "type": "integer",
          "minimum": 0
        },
        "usage": {
          "$ref": "#/$defs/usage"
        },
        "sent": {
          "type": "object",
          "properties": {
            "read": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "searches": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "masked": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 0
              }
            },
            "matched": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "검색 결과로 줄이 나간 파일"
            },
            "listed": {
              "type": "integer",
              "minimum": 0,
              "description": "list_files 로 나간 파일 이름 수"
            },
            "refused": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "비밀값이 있을 수 있어 읽기를 거절한 파일(나가지 않았다)"
            }
          },
          "required": [
            "listed",
            "masked",
            "matched",
            "read",
            "refused",
            "searches"
          ],
          "additionalProperties": false,
          "description": "이 질문에서 밖으로 나간 것: 에이전트가 읽은 파일, 검색어, 검색 결과로 줄이 나간 파일, 목록으로 나간 이름 수, 가린 비밀값 수(종류별). refused 는 나가지 않은 것이다"
        },
        "results": {
          "type": "integer",
          "minimum": 0
        },
        "raw": {
          "type": "string"
        }
      },
      "required": [
        "calls",
        "failure",
        "n",
        "policy",
        "sent",
        "usage"
      ],
      "additionalProperties": false,
      "description": "모델에게 보낸 질문 하나"
    },
    "record": {
      "type": "object",
      "properties": {
        "policy": {
          "type": "string"
        },
        "entry": {
          "type": "string"
        },
        "line": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outcomes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/outcome"
          }
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "role": {
          "type": "string"
        },
        "related": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string"
              },
              "why": {
                "type": "string"
              }
            },
            "required": [
              "file",
              "why"
            ],
            "additionalProperties": false
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "rule": {
                "type": "string"
              },
              "line": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "outcome": {
                "$ref": "#/$defs/outcome"
              }
            },
            "required": [
              "line",
              "outcome",
              "rule"
            ],
            "additionalProperties": false
          }
        },
        "verdict": {
          "anyOf": [
            {
              "$ref": "#/$defs/verdict"
            },
            {
              "type": "null"
            }
          ]
        },
        "action": {
          "$ref": "#/$defs/action"
        },
        "reason": {
          "type": "string"
        },
        "citations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          }
        },
        "question": {
          "type": [
            "integer",
            "null"
          ]
        },
        "line_model": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "action",
        "entry",
        "policy"
      ],
      "additionalProperties": false,
      "description": "진입 파일 하나에 대한 답과 반영 결과"
    },
    "stage": {
      "type": "object",
      "properties": {
        "judge": {
          "type": "string"
        },
        "mode": {
          "enum": [
            "review",
            "combined",
            "independent",
            "discover"
          ]
        },
        "units": {
          "type": "integer",
          "minimum": 0
        },
        "asked": {
          "type": "integer",
          "minimum": 0
        },
        "index": {
          "type": "object",
          "properties": {
            "files": {
              "type": "integer",
              "minimum": 0
            },
            "edges": {
              "type": "integer",
              "minimum": 0
            },
            "packages": {
              "type": "integer",
              "minimum": 0
            },
