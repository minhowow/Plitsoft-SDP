{
  "$defs": {
    "Expected": {
      "description": "픽스처가 기대하는 판정.",
      "enum": [
        "compliant",
        "needs-review",
        "needs-review-uncertain",
        "not-applicable"
      ],
      "title": "Expected",
      "type": "string"
    },
    "FixtureCase": {
      "additionalProperties": false,
      "properties": {
        "ai": {
          "additionalProperties": {
            "anyOf": [
              {
                "$ref": "#/$defs/StubAnswer"
              },
              {
                "$ref": "#/$defs/Stub"
              }
            ]
          },
          "title": "Ai",
          "type": "object"
        },
        "decoy-for": {
          "items": {
            "type": "string"
          },
          "title": "Decoy-For",
          "type": "array"
        },
        "expect": {
          "anyOf": [
            {
              "$ref": "#/$defs/Expected"
            },
            {
              "additionalProperties": {
                "$ref": "#/$defs/Expected"
              },
              "type": "object"
            }
          ],
          "title": "Expect"
        },
        "file": {
          "title": "File",
          "type": "string"
        },
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "lang": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lang"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "file",
        "expect"
      ],
      "title": "FixtureCase",
      "type": "object"
    },
    "Stub": {
      "additionalProperties": false,
      "description": "판정자가 이렇게 답했다고 치자. 근거 관문은 엔진이 그대로 적용한다.",
      "properties": {
        "answer": {
          "$ref": "#/$defs/StubAnswer"
        },
        "cite": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cite"
        }
      },
      "required": [
        "answer"
      ],
      "title": "Stub",
      "type": "object"
    },
    "StubAnswer": {
      "description": "스텁 답. unknown·n/a 는 판정자가 그렇게 **답한** 것이다(실패가 아니다). 대안 질문에서는 판정에 넣지 않고\nAI 확인 필요로 남는다(판정자가 없을 때와 같다). 적용 질문에서는 적용이 '모름'으로 남는다. 판정자가 실패한\n경우는 스텁을 적지 않은 것과 같다.",
      "enum": [
        "yes",
        "no",
        "n/a",
        "unknown"
      ],
      "title": "StubAnswer",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "policypack/test-0.1",
      "title": "Apiversion",
      "type": "string"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/FixtureCase"
      },
      "minItems": 1,
      "title": "Cases",
      "type": "array"
    },
    "rule": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rule"
    }
  },
  "required": [
    "apiVersion",
    "cases"
  ],
  "title": "정책 테스트 v0.1",
  "type": "object"
}
